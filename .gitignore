# Local secrets; keep a shareable example
.env
.env.*
!.env.example

# Reserved temporary directories and tool caches
# Keep shareable Codex/Mrite instructions/configuration; ignore only local runtime paths.
tmp/
temp/
.cache/
.codex/tmp/
.codex/logs/
.codex/sessions/
.mrite/tmp/
.mrite/cache/
.mrite/logs/

# Do not blanket-ignore .py, .m, .tex, .pdf, .csv, .xlsx, .mat or result folders.
# For large files shared via cloud storage, add their specific paths after review.
